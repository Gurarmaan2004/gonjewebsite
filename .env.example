# SMTP credentials for the enquiry forms (EaaS/DaaS/SaaS "Send enquiry" —
# see app/api/contact/route.ts). Copy this file to .env.local for local dev
# and set the same values in your hosting platform's environment variables
# for production. Never commit the real values — .env.local is gitignored.
#
# Hostinger's SMTP (Titan Mail) settings, for the enquiries@gonje.com mailbox:
#   Host: smtp.hostinger.com
#   Port: 465 (SSL) — or 587 with SMTP_SECURE=false for STARTTLS
#   User: the full mailbox address
#   Pass: that mailbox's password (an app password if Hostinger offers one)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=enquiries@gonje.com
SMTP_PASS=
